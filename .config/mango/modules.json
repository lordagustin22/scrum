{
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "Bat: {capacity}% {icon} {time}",
        "format-plugged": "{capacity}% ",
        "format-alt": "Bat {capacity}%",
        "format-time": "{H}:{M}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip": true
    },
    "network": {
        "format": "Online",
        "format-disconnected": "Disconnected ⚠"
    },
    "ext/workspaces": {
        "format": "{icon}",
        "ignore-hidden": false,
        "on-click": "activate",
        "sort-by-id": true
    },
    "dwl/tags": {
        "num-tags": 9
    },
    "dwl/window#layout": {
        "format": "[{layout}]"
    },
    "dwl/window#title": {
        "format": "{title}"
    },
    "custom/sep": {
        "format": "|",
        "interval": 0
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d/%m/%Y}",
        "timezone": "America/Argentina/Buenos_Aires",
        "on-click-right": "footclient -e calcure",
        "tooltip": true,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "wireplumber": {
        "max-volume": 150,
        "nospacing": 1,
        "tooltip": true,
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "on-click": "pavucontrol",
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "mpd": {
        "format": "{stateIcon} {consumeIcon} {artist} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ",
        "format-disconnected": "Desconectado",
        "format-stopped": "{consumeIcon} Detenido ",
        "interval": 10,
        "on-click": "mpc toggle",
        "on-click-right": "footclient -- ncmpcpp",
        "on-scroll-up": "mpc seek +3",
        "on-scroll-down": "mpc seek -3",
        "artist-len": 20,
        "title-len": 20,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (conetado nwnw)",
        "tooltip-format-disconnected": "MPD (dekonetado nwnw)"
    },
    "cpu": {
        "format": " {usage}%",
        "on-click": "footclient -- htop",
        "tooltip": true
    },
    "tray": {
        "icon-size": 14,
        "rotate": 0,
        "spacing": 5,
        "tooltip": true
    },
    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}G/{total:0.1f}G",
        "max-length": 20
    }
}
