{
  "include": [
    "~/.config/mango/modules.json"
  ],
  "layer": "top",
  "output": [
    "HDMI-A-1",
    "eDP-1"
  ],
  "spacing": 0,
  "height": 0,
  "modules-left": [
    "ext/workspaces",
    "custom/sep",
    "dwl/window#layout",
    "custom/sep",
    "dwl/window#title"
  ],
  "modules-center": [
    "mpd"
  ],
  "modules-right": [
    "custom/sep",
    "clock",
    "custom/sep",
    "battery",
    "custom/sep",
    "wireplumber",
    "custom/sep",
    "cpu",
    "custom/sep",
    "backlight",
    "custom/sep",
    "tray"
  ]
}
